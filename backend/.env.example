# ─────────────────────────────────────────────────────────────
# BrandyBot Backend — Environment Variables Reference
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — only commit .env.example
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (Supabase PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://postgres:<password>@<project>.supabase.co:5432/postgres

# ── CORS ─────────────────────────────────────────────────────
# Frontend URL — set to your Netlify URL in production
# Example: https://brandybot.netlify.app
FRONTEND_URL=http://localhost:5173

# Backend's own public URL (for CSP headers) — set to your Vercel URL
# Example: https://brandybot-api.vercel.app
BACKEND_URL=http://localhost:5000

# ── Firebase Admin SDK ────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── AI — Logo Generation (Replicate) ─────────────────────────
# Primary logo generation model (custom-trained Flux LoRA)
REPLICATE_API_TOKEN=r8_your_replicate_token

# ── AI — LLM (at least one required for chat/guidelines) ──────
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk_your-groq-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# ── Image Hosting (required for logo/mockup storage) ──────────
IMGBB_API_KEY=your-imgbb-api-key

# ── Background Removal ────────────────────────────────────────
REMOVE_BG_API_KEY=your-removebg-api-key

# ── Python AI Service (optional, for advanced mockups) ────────
# Set to Railway/Render URL when deployed, or ngrok URL for local dev
AI_SERVICE_URL=http://localhost:8000

# ── Pollinations API ─────────────────────────────────────────
POLLINATIONS_API_KEY=sk_your-pollinations-key

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── JWT (kept for future use) ─────────────────────────────────
JWT_SECRET=your-strong-secret-key-change-in-production
